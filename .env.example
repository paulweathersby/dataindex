# Copy this file to `.env` at the project root and fill in real values.
# The real `.env` is loaded by config/app.cfg.php via vlucas/phpdotenv and
# must NEVER be committed.

# --- Application -----------------------------------------------------------

# Absolute path on disk where the application is deployed.
APP_PATH=/var/customers/webs/dataindex

# Fully-qualified URL the site is served from (include trailing slash).
SITE_URL=https://www.dataindex.online/

# Set to "production" on live servers. Anything else is treated as dev
# and will display PHP errors in the browser.
APP_ENV=production

# --- Primary (companies) database -----------------------------------------
DB_DBMS=mysql
DB_HOST=127.0.0.1
DB_NAME=company
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- Secondary (dataindex) database ---------------------------------------
DB2_DBMS=mysql
DB2_HOST=127.0.0.1
DB2_NAME=dataindex
DB2_USER=CHANGE_ME
DB2_PASSWORD=CHANGE_ME

# --- MongoDB ---------------------------------------------------------------
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=company

# --- Auth0 -----------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=CHANGE_ME
AUTH0_CLIENT_SECRET=CHANGE_ME
# Generate with: openssl rand -hex 32
AUTH0_COOKIE_SECRET=CHANGE_ME
AUTH0_BASE_URL=https://www.dataindex.online

# --- Companies House API ---------------------------------------------------
# Used by lib/apiRequests.class.php to fetch officers and filing history.
# Get one at https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# --- HMRC VAT Lookup -------------------------------------------------------
# (Optional – only if you call the HMRC VAT API from apiRequests.class.php)
HMRC_VAT_API_TOKEN=

# --- OpenReplay (optional analytics) --------------------------------------
# Self-hosted ingest URL (include /ingest path), e.g. https://www.dataindex.online:2096/ingest
OPENREPLAY_PROJECT_KEY=
OPENREPLAY_INGEST_POINT=https://www.dataindex.online:2096/ingest

# --- Google Analytics (optional) -----------------------------------------
GA_MEASUREMENT_ID=
